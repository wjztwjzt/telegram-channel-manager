# ============ Telegram 用户账号（userbot）============
# 在 https://my.telegram.org 申请；该账号需设为被监控频道的【管理员】，
# 否则无法读取管理员日志（加入/退出/邀请来源）。
API_ID=12345678
API_HASH=你的_api_hash
PHONE=+8613800000000
# 登录后生成的 session 文件名（无需手动创建）
SESSION_NAME=session

# ============ 管理机器人（Bot）============
# 在 @BotFather 创建
BOT_TOKEN=123456789:AA...你的bot_token
# 允许使用本机器人的管理员用户 ID，逗号分隔
ADMIN_IDS=123456789

# ============ 被监控频道（逗号分隔，用户名或数字 ID）============
CHANNELS=@mychannel

# ============ MySQL ============
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的密码
MYSQL_DATABASE=telegram_channel_manager

# ============ 采集频率（秒）============
MEMBER_MONITOR_INTERVAL=60
MEMBER_SYNC_INTERVAL=3600
MESSAGE_STATS_INTERVAL=3600
MESSAGE_STATS_LIMIT=50
DAILY_REPORT_HOUR=0
DAILY_REPORT_MINUTE=5
